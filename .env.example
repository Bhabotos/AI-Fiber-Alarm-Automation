# This project runs entirely inside n8n. n8n does not read this file directly —
# credentials are configured in n8n's own Credential Manager UI. These variables
# document the three external services the workflows actually depend on, for use
# by any local tooling/scripts you build around this pipeline.

# WF-03 (AI Classification Engine) — used as a Header Auth credential for
# https://api.anthropic.com/v1/messages ("x-api-key" header)
ANTHROPIC_API_KEY=

# WF-04 (Site Metadata Enrichment) — Google Sheets OAuth2 credential
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
# The spreadsheet must contain a "SiteMetadata" sheet/tab looked up by a "Site ID" column
SITE_METADATA_SHEET_ID=

# WF-08 (Telegram Notifier) — Telegram Bot API credential
TELEGRAM_BOT_TOKEN=
